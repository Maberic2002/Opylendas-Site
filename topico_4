CSS (Escala de Espaçamento e Estilo dos Cards)
CSS
/* Escala de Espaçamento Fixa (Ritmo Visual) */
:root {
  --spacing-xs: 8px;
  --spacing-sm: 16px;
  --spacing-md: 24px;
  --spacing-lg: 32px;
}

/* Aplicação da escala nos Cards de Preço */
.pricing-card {
  background-color: var(--opy-creme, #FFFCEE);
  border: 2px solid var(--opy-verde-escuro, #485F4D);
  border-radius: 12px;
  margin-bottom: var(--spacing-md); /* Margin externa constante */
}

/* Variações de Padding usando a escala */
.pricing-card-compact {
  padding: var(--spacing-sm); /* Padding interno de 16px */
}

.pricing-card-standard {
  padding: var(--spacing-md); /* Padding interno de 24px */
}

.pricing-card-featured {
  padding: var(--spacing-lg); /* Padding interno de 32px (Destaque) */
}

HTML
HTML
<!-- Seção de Cards de Preço / Boxes Misteriosas -->
<section class="container py-5" id="cards-preco">

/* Exemplo com CSS Grid puro de 12 colunas caso não queira usar as classes nativas do Bootstrap */
.blog-grid-container {
  display: grid;
  grid-template-columns: repeat(12, 1fr);
  gap: 24px;
  max-width: 1140px;
  margin: 0 auto;
}

.blog-sidebar {
  grid-column: span 3;
}

.blog-content {
  grid-column: span 9;
}

@media (max-width: 768px) {
  .blog-sidebar, .blog-content {
    grid-column: span 12; /* No mobile ocupa 100% */
  }
}

